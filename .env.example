# Database configuration
# For local development, sqlite is used by default.
# For production/PostgreSQL + PostGIS, use: postgresql://username:password@localhost:5432/bioplan_db
DATABASE_URL=sqlite:///./bioplan.db

# Authentication
JWT_SECRET=supersecretjwtsecretkeyreplaceinproduction1234567890
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server configurations
HOST=0.0.0.0
PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
